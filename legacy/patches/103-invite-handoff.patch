diff --git a/packages/oauth/oauth-provider-ui/src/lib/invite-handoff.ts b/packages/oauth/oauth-provider-ui/src/lib/invite-handoff.ts
new file mode 100644
index 0000000..392be07
--- /dev/null
+++ b/packages/oauth/oauth-provider-ui/src/lib/invite-handoff.ts
@@ -0,0 +1,83 @@
+/**
+ * @NOTE LinkJar: the invitation hand-off. The LinkJar app opens the
+ * authorization page with the invite code in the URL fragment:
+ * `#invite=<code>`, where `<code>` is the code passed through
+ * `encodeURIComponent`. The fragment never reaches the server.
+ *
+ * The page reads the code once at load, before anything rewrites the URL (the
+ * `request_uri` canonicalization, then the `#step=` routing of
+ * `location-step.ts`), and removes it from the fragment. The code stays in
+ * memory and in `sessionStorage`, bound to the authorization request, so the
+ * step routing and a reload in the same tab keep it. It is dropped once the
+ * account exists, the server refuses the code or the request ends.
+ */
+
+const STORAGE_KEY = 'linkjar-invite-handoff'
+
+type StoredHandoff = { requestUri: string; inviteCode: string }
+
+let current: string | undefined
+
+/** Call once at page load, before the page writes to the URL. */
+export function captureInviteHandoff(requestUri: string): void {
+  const params = new URLSearchParams(window.location.hash.slice(1))
+  const inviteCode = params.get('invite') || undefined
+  if (params.has('invite')) {
+    params.delete('invite')
+    const rest = params.toString()
+    window.history.replaceState(
+      window.history.state,
+      '',
+      window.location.pathname +
+        window.location.search +
+        (rest ? `#${rest}` : ''),
+    )
+  }
+
+  const stored = readStored()
+  if (inviteCode) {
+    current = inviteCode
+    writeStored({ requestUri, inviteCode })
+  } else if (stored?.requestUri === requestUri) {
+    current = stored.inviteCode
+  } else if (stored) {
+    // Left over from an earlier authorization request in this tab.
+    forgetInviteHandoff()
+  }
+}
+
+/** The invite code handed off for this authorization request, if any. */
+export function getInviteHandoff(): string | undefined {
+  return current
+}
+
+export function forgetInviteHandoff(): void {
+  current = undefined
+  try {
+    window.sessionStorage.removeItem(STORAGE_KEY)
+  } catch {
+    // Without storage, nothing was stored.
+  }
+}
+
+function readStored(): StoredHandoff | undefined {
+  try {
+    const value = JSON.parse(
+      window.sessionStorage.getItem(STORAGE_KEY) ?? 'null',
+    )
+    return typeof value?.requestUri === 'string' &&
+      typeof value?.inviteCode === 'string'
+      ? value
+      : undefined
+  } catch {
+    return undefined
+  }
+}
+
+function writeStored(value: StoredHandoff): void {
+  try {
+    window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(value))
+  } catch {
+    // Without storage, the code lasts until the page unloads.
+  }
+}
