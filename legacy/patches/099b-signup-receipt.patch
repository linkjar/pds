diff --git a/packages/pds/src/account-manager/helpers/signup-receipt.ts b/packages/pds/src/account-manager/helpers/signup-receipt.ts
new file mode 100644
index 0000000..94fd8bc
--- /dev/null
+++ b/packages/pds/src/account-manager/helpers/signup-receipt.ts
@@ -0,0 +1,48 @@
+import type { Did, SignupAuthorization } from '@atproto/oauth-provider/store'
+import { InvalidRequestError } from '@atproto/xrpc-server'
+import type { OAuthOutput } from '../../auth-output.js'
+import { toDateISO } from '../../db/index.js'
+import type { AccountDb } from '../db/index.js'
+
+/** Mark the request inside the account transaction; a failed binding rolls it back. */
+export async function registerSignupReceipt(
+  db: AccountDb,
+  authorization: SignupAuthorization,
+  did: Did,
+): Promise<void> {
+  db.assertTransaction()
+  const result = await db.db
+    .updateTable('authorization_request')
+    .set({ signupDid: did })
+    .where('id', '=', authorization.requestId)
+    .where('clientId', '=', authorization.clientId)
+    .where('deviceId', '=', authorization.deviceId)
+    .where('expiresAt', '>', toDateISO(new Date()))
+    .where('did', 'is', null)
+    .where('code', 'is', null)
+    .where('signupDid', 'is', null)
+    .executeTakeFirst()
+  if (result.numUpdatedRows !== 1n) {
+    throw new InvalidRequestError(
+      'Account creation authorization is no longer available',
+    )
+  }
+}
+
+/** The verified JWT identifies one persisted session, including after token rotation. */
+export function pendingSignupReceiptQB(
+  db: AccountDb,
+  credentials: OAuthOutput['credentials'],
+) {
+  if (!credentials.tokenId || !credentials.clientId) {
+    throw new InvalidRequestError('OAuth session is required', 'InvalidToken')
+  }
+  return db.db
+    .selectFrom('token')
+    .where('tokenId', '=', credentials.tokenId)
+    .where('clientId', '=', credentials.clientId)
+    .where('did', '=', credentials.did)
+    .where('signupDid', '=', credentials.did)
+    .where('expiresAt', '>', toDateISO(new Date()))
+    .select('id')
+}
