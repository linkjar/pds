diff --git a/packages/pds/src/api/io/linkjar/account/acknowledgeSignupReceipt.ts b/packages/pds/src/api/io/linkjar/account/acknowledgeSignupReceipt.ts
new file mode 100644
index 0000000..a0e1bb0
--- /dev/null
+++ b/packages/pds/src/api/io/linkjar/account/acknowledgeSignupReceipt.ts
@@ -0,0 +1,34 @@
+import { InvalidRequestError, type Server } from '@atproto/xrpc-server'
+import { pendingSignupReceiptQB } from '../../../../account-manager/helpers/signup-receipt.js'
+import type { AppContext } from '../../../../context.js'
+import { io } from '../../../../lexicons/index.js'
+
+export default function (server: Server, ctx: AppContext) {
+  server.add(io.linkjar.account.acknowledgeSignupReceipt, {
+    auth: ctx.authVerifier.authorization({
+      authorize: () => {
+        // @NOTE This is metadata about the caller's own session, like getSession.
+      },
+    }),
+    handler: async ({ auth, res }) => {
+      res.setHeader('Cache-Control', 'no-store')
+      const { credentials } = auth
+      if (credentials.type !== 'oauth') {
+        throw new InvalidRequestError(
+          'OAuth session is required',
+          'InvalidToken',
+        )
+      }
+      const db = ctx.accountManager.db
+      await db.db
+        .updateTable('token')
+        .set({ signupDid: null })
+        .where('id', 'in', pendingSignupReceiptQB(db, credentials))
+        .execute()
+      return {
+        encoding: 'application/json',
+        body: { created: false, did: credentials.did },
+      }
+    },
+  })
+}
diff --git a/packages/pds/src/api/io/linkjar/account/getSignupReceipt.ts b/packages/pds/src/api/io/linkjar/account/getSignupReceipt.ts
new file mode 100644
index 0000000..97d6573
--- /dev/null
+++ b/packages/pds/src/api/io/linkjar/account/getSignupReceipt.ts
@@ -0,0 +1,40 @@
+import { InvalidRequestError, type Server } from '@atproto/xrpc-server'
+import { pendingSignupReceiptQB } from '../../../../account-manager/helpers/signup-receipt.js'
+import type { AppContext } from '../../../../context.js'
+import { io } from '../../../../lexicons/index.js'
+
+export default function (server: Server, ctx: AppContext) {
+  server.add(io.linkjar.account.getSignupReceipt, {
+    auth: ctx.authVerifier.authorization({
+      authorize: () => {
+        // @NOTE This is metadata about the caller's own session, like getSession.
+      },
+    }),
+    handler: async ({ auth, res }) => {
+      res.setHeader('Cache-Control', 'no-store')
+      const { credentials } = auth
+      if (credentials.type !== 'oauth') {
+        throw new InvalidRequestError(
+          'OAuth session is required',
+          'InvalidToken',
+        )
+      }
+      const db = ctx.accountManager.db
+      const pending = await pendingSignupReceiptQB(
+        db,
+        credentials,
+      ).executeTakeFirst()
+      const account = pending
+        ? await ctx.accountManager.getAccount(credentials.did)
+        : undefined
+      return {
+        encoding: 'application/json',
+        body: {
+          created: Boolean(pending && account),
+          did: credentials.did,
+          handle: account?.handle ?? undefined,
+        },
+      }
+    },
+  })
+}
