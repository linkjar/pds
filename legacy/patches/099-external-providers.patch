--- /dev/null
+++ b/packages/oauth/oauth-provider/src/account/account-manager.external.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { DeviceId } from '../device/device-id.js'
+import { AccountManager } from './account-manager.js'
+import type { AccountStore } from './account-store.js'
+
+const account = {
+  did: 'did:plc:aaaaaaaaaaaaaaaaaaaaaaaa' as const,
+  pds: 'did:web:pds.test' as const,
+  deactivated: false,
+}
+const input = {
+  locale: 'en',
+  handle: 'alice.test' as const,
+  email: 'alice@example.com',
+  password: 'new-password',
+}
+describe('signup consent policy', () => {
+  it.each([true, false])(
+    'only preauthorizes when signup policy returns %s',
+    async (authorizeClient) => {
+      const store = {
+        createAccount: vi.fn(async () => account),
+      } as unknown as AccountStore
+      const preauthorize = vi.fn(async () => {})
+      const onSignedUp = vi.fn(async () => ({ authorizeClient }))
+      const manager = new AccountManager(
+        'https://pds.test',
+        store,
+        { onSignedUp },
+        { inviteCodeRequired: false },
+      )
+      await manager.createAccount(
+        'dev-a' as DeviceId,
+        { ipAddress: '127.0.0.1', port: 443 },
+        input,
+        'https://client.test/metadata.json',
+        preauthorize,
+      )
+      expect(onSignedUp).toHaveBeenCalledWith(
+        expect.objectContaining({
+          account,
+          clientId: 'https://client.test/metadata.json',
+        }),
+      )
+      expect(preauthorize).toHaveBeenCalledTimes(authorizeClient ? 1 : 0)
+    },
+  )
+})
