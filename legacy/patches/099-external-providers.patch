@@ -0,0 +1,115 @@
+import { randomBytes } from 'node:crypto'
+import type { DeviceId } from '../device/device-id.js'
+import { InvalidRequestError } from '../errors/invalid-request-error.js'
+import type { RequestUri } from '../request/request-uri.js'
+import type { ExternalProviderId } from './external-provider.js'
+
+type Flow = {
+  provider: ExternalProviderId
+  deviceId: DeviceId
+  requestUri?: RequestUri
+  verifier: string
+  nonce: string
+  expiresAt: number
+  response?:
+    | { code: string; user?: string; error?: never }
+    | { error: string; code?: never; user?: never }
+}
+
+/** Bounded, one-use browser transactions. A restart cancels in-flight sign-ins. */
+export class ExternalFlowStore {
+  private readonly flows = new Map<string, Flow>()
+  private readonly attempts = new Map<
+    string,
+    { expiresAt: number; count: number }
+  >()
+  private nextCleanup = 0
+  constructor(private readonly now: () => number = Date.now) {}
+
+  /** Limit work before outbound identity-provider requests; keys come from trusted request metadata. */
+  allow(ip: string, stage: 'start' | 'complete'): void {
+    const now = this.now()
+    if (now >= this.nextCleanup) {
+      for (const [key, value] of this.attempts)
+        if (value.expiresAt <= now) this.attempts.delete(key)
+      this.nextCleanup = now + 60_000
+    }
+    const key = `${stage}:${ip}`
+    const previous = this.attempts.get(key)
+    const bucket =
+      previous && previous.expiresAt > now
+        ? previous
+        : { expiresAt: now + 60_000, count: 0 }
+    if (
+      (!previous && this.attempts.size >= 10_000) ||
+      bucket.count >= (stage === 'start' ? 20 : 10)
+    ) {
+      throw new InvalidRequestError(
+        'Too many external sign-in attempts. Try again shortly.',
+      )
+    }
+    bucket.count++
+    this.attempts.set(key, bucket)
+  }
+
+  create(input: Pick<Flow, 'provider' | 'deviceId' | 'requestUri'>): {
+    state: string
+    flow: Flow
+  } {
+    for (const [state, flow] of this.flows)
+      if (flow.expiresAt <= this.now()) this.flows.delete(state)
+    if (
+      this.flows.size >= 1000 ||
+      [...this.flows.values()].filter((f) => f.deviceId === input.deviceId)
+        .length >= 3
+    ) {
+      throw new InvalidRequestError('Too many pending external sign-ins')
+    }
+    const state = randomBytes(32).toString('base64url')
+    const flow: Flow = {
+      ...input,
+      verifier: randomBytes(32).toString('base64url'),
+      nonce: randomBytes(32).toString('base64url'),
+      expiresAt: this.now() + 600_000,
+    }
+    this.flows.set(state, flow)
+    return { state, flow }
+  }
+
+  receive(
+    state: string,
+    provider: ExternalProviderId,
+    response: NonNullable<Flow['response']>,
+  ): void {
+    const flow = this.get(state, provider)
+    if (flow.response)
+      throw new InvalidRequestError('External response already received')
+    flow.response = response
+  }
+
+  consume(
+    state: string,
+    provider: ExternalProviderId,
+    deviceId: DeviceId,
+  ): Flow & { response: NonNullable<Flow['response']> } {
+    const flow = this.get(state, provider)
+    if (flow.deviceId !== deviceId)
+      throw new InvalidRequestError(
+        'External sign-in belongs to another device',
+      )
+    this.flows.delete(state)
+    if (!flow.response)
+      throw new InvalidRequestError('Missing external response')
+    return { ...flow, response: flow.response }
+  }
+
+  private get(state: string, provider: ExternalProviderId): Flow {
+    const flow = this.flows.get(state)
+    if (!flow || flow.provider !== provider || flow.expiresAt <= this.now()) {
+      if (flow?.expiresAt && flow.expiresAt <= this.now())
+        this.flows.delete(state)
+      throw new InvalidRequestError('Unknown or expired external sign-in')
+    }
+    return flow
+  }
+}
