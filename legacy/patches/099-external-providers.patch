+import { describe, expect, it } from 'vitest'
+import type { DeviceId } from '../device/device-id.js'
+import type { RequestUri } from '../request/request-uri.js'
+import { ExternalFlowStore } from './external-flow-store.js'
+const input = {
+  provider: 'google' as const,
+  deviceId: 'dev_a' as DeviceId,
+  requestUri: 'urn:ietf:params:oauth:request_uri:abc' as RequestUri,
+}
+describe('external browser transactions', () => {
+  it('bounds per-IP work across device rotation and expires the rate window', () => {
+    let now = 0
+    const store = new ExternalFlowStore(() => now)
+    for (let i = 0; i < 20; i++) store.allow('127.0.0.1', 'start')
+    expect(() => store.allow('127.0.0.1', 'start')).toThrow('Too many')
+    for (let i = 0; i < 10; i++) store.allow('127.0.0.1', 'complete')
+    expect(() => store.allow('127.0.0.1', 'complete')).toThrow('Too many')
+    expect(() => store.allow('127.0.0.2', 'start')).not.toThrow()
+    now = 60_000
+    expect(() => store.allow('127.0.0.1', 'start')).not.toThrow()
+  })
+  it('consumes once, binds provider and original device, and hides verifier from state', () => {
+    const store = new ExternalFlowStore()
+    const { state, flow } = store.create(input)
+    expect(state).not.toBe(flow.verifier)
+    expect(flow.nonce).not.toBe(state)
+    expect(() => store.receive(state, 'apple', { code: 'x' })).toThrow()
+    store.receive(state, 'google', { code: 'x' })
+    expect(() => store.consume(state, 'google', 'dev_b' as DeviceId)).toThrow()
+    expect(store.consume(state, 'google', input.deviceId).response.code).toBe(
+      'x',
+    )
+    expect(() => store.consume(state, 'google', input.deviceId)).toThrow()
+  })
+  it('expires and bounds pending flows per device', () => {
+    let now = 0
+    const store = new ExternalFlowStore(() => now)
+    const { state } = store.create(input)
+    store.create(input)
+    store.create(input)
+    expect(() => store.create(input)).toThrow('Too many')
+    now = 600_000
+    expect(() => store.receive(state, 'google', { code: 'x' })).toThrow(
+      'expired',
+    )
+    expect(() => store.create(input)).not.toThrow()
+  })
+  it('cannot replace the first callback or complete before a callback', () => {
+    const store = new ExternalFlowStore()
+    const first = store.create(input)
+    expect(() => store.consume(first.state, 'google', input.deviceId)).toThrow(
+      'Missing',
+    )
+    const second = store.create(input)
+    store.receive(second.state, 'google', { code: 'first' })
+    expect(() =>
+      store.receive(second.state, 'google', { code: 'replacement' }),
+    ).toThrow()
+    expect(
+      store.consume(second.state, 'google', input.deviceId).response.code,
+    ).toBe('first')
+  })
+})
