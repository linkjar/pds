+import type { Did } from '@atproto/did'
+import type {
+  ExternalIdentity,
+  ExternalProviderId,
+} from '@atproto/oauth-provider/store'
+import type { AccountDb } from '../db/index.js'
+
+/** Atomically associates an identity; a competing DID always fails. */
+export async function linkExternalIdentity(
+  db: AccountDb,
+  did: Did,
+  identity: ExternalIdentity,
+): Promise<void> {
+  const now = new Date().toISOString()
+  await db.db
+    .insertInto('external_identity')
+    .values({
+      provider: identity.provider,
+      subject: identity.subject,
+      did,
+      assertedEmail: identity.email ?? null,
+      emailVerified: identity.emailVerified ? 1 : 0,
+      displayName: identity.displayName ?? null,
+      createdAt: now,
+      lastUsedAt: now,
+    })
+    .execute()
+}
+
+export async function findExternalIdentity(
+  db: AccountDb,
+  provider: ExternalProviderId,
+  subject: string,
+): Promise<Did | null> {
+  const row = await db.db
+    .updateTable('external_identity')
+    .set({ lastUsedAt: new Date().toISOString() })
+    .where('provider', '=', provider)
+    .where('subject', '=', subject)
+    .returning('did')
+    .executeTakeFirst()
+  return row ? (row.did as Did) : null
+}
