@@ -0,0 +1,459 @@
+import { Buffer } from 'node:buffer'
+import { type JWTPayload, SignJWT, exportJWK, generateKeyPair } from 'jose'
+import { assert, beforeAll, describe, expect, it, test, vi } from 'vitest'
+import {
+  type ExternalProviderId,
+  createExternalProviders,
+} from './external-provider.js'
+
+const input = {
+  redirectUri: 'https://pds.example.com/oauth/external/google/callback',
+  code: 'provider-code',
+  verifier: 'v'.repeat(43),
+  nonce: 'random-nonce-bound-to-this-request',
+}
+const clientId = 'client-id'
+let keys: Awaited<ReturnType<typeof generateKeyPair>>
+let jwks: { keys: Awaited<ReturnType<typeof exportJWK>>[] }
+
+beforeAll(async () => {
+  keys = await generateKeyPair('RS256')
+  jwks = { keys: [{ ...(await exportJWK(keys.publicKey)), kid: 'test-key' }] }
+})
+
+function provider(id: ExternalProviderId) {
+  const value = createExternalProviders({
+    [id]: { clientId, clientSecret: 'client-secret' },
+  })[0]
+  assert(value)
+  return value
+}
+
+function claims(id: 'apple' | 'google'): JWTPayload {
+  const now = Math.floor(Date.now() / 1000)
+  return {
+    iss:
+      id === 'apple'
+        ? 'https://appleid.apple.com'
+        : 'https://accounts.google.com',
+    aud: clientId,
+    sub: `${id}-stable-subject`,
+    nonce: input.nonce,
+    iat: now,
+    exp: now + 300,
+    email: 'person@example.com',
+    email_verified: true,
+    name: 'A Person',
+  }
+}
+
+function sign(payload: JWTPayload, key = keys.privateKey) {
+  return new SignJWT(payload)
+    .setProtectedHeader({ alg: 'RS256', kid: 'test-key' })
+    .sign(key)
+}
+
+function oidcResponses(idToken: string): typeof fetch {
+  return async (url) => {
+    const address = String(url)
+    if (
+      address === 'https://oauth2.googleapis.com/token' ||
+      address === 'https://appleid.apple.com/auth/token'
+    ) {
+      return Response.json({ id_token: idToken, access_token: 'unused-access' })
+    }
+    if (
+      address === 'https://www.googleapis.com/oauth2/v3/certs' ||
+      address === 'https://appleid.apple.com/auth/keys'
+    ) {
+      return Response.json(jwks)
+    }
+    throw new Error(`Unexpected request: ${address}`)
+  }
+}
+
+function githubResponses(
+  emails: unknown,
+  user: unknown = {
+    id: 123456,
+    login: 'mutable-login',
+    name: 'A Person',
+    email: 'untrusted-profile@example.com',
+  },
+): typeof fetch {
+  return async (url) => {
+    switch (String(url)) {
+      case 'https://github.com/login/oauth/access_token':
+        return Response.json({
+          access_token: 'github-token',
+          token_type: 'bearer',
+        })
+      case 'https://api.github.com/user':
+        return Response.json(user)
+      case 'https://api.github.com/user/emails?per_page=100':
+        return Response.json(emails)
+      default:
+        throw new Error('Unexpected request')
+    }
+  }
+}
+
+describe(createExternalProviders, () => {
+  it('disables providers unless explicitly configured', () => {
+    expect(createExternalProviders({})).toEqual([])
+    expect(createExternalProviders({ google: undefined })).toEqual([])
+    expect(provider('apple').label).toBe('Apple')
+    expect(provider('google').label).toBe('Google')
+    expect(provider('github').label).toBe('GitHub')
+  })
+
+  test.each(['', ' ', 'secret\nvalue', 'x'.repeat(16_385)])(
+    'rejects malformed client secret %j',
+    (clientSecret) => {
+      expect(() =>
+        createExternalProviders({ google: { clientId, clientSecret } }),
+      ).toThrow()
+    },
+  )
+
+  test.each(['apple', 'google', 'github'] as const)(
+    '%s authorization preserves state and only requests code flow',
+    (id) => {
+      const url = provider(id).authorizationUrl({
+        ...input,
+        state: 'unpredictable-state',
+        codeChallenge: 'c'.repeat(43),
+      })
+      expect(url.protocol).toBe('https:')
+      expect(url.searchParams.get('client_id')).toBe(clientId)
+      expect(url.searchParams.get('redirect_uri')).toBe(input.redirectUri)
+      expect(url.searchParams.get('response_type')).toBe('code')
+      expect(url.searchParams.get('state')).toBe('unpredictable-state')
+      expect(url.searchParams.has('client_secret')).toBe(false)
+      if (id === 'apple') {
+        expect(url.searchParams.get('response_mode')).toBe('form_post')
+        expect(url.searchParams.get('scope')).toBe('name email')
+        expect(url.searchParams.get('nonce')).toBe(input.nonce)
+        expect(url.searchParams.has('code_challenge')).toBe(false)
+      } else {
+        expect(url.searchParams.get('code_challenge')).toBe('c'.repeat(43))
+        expect(url.searchParams.get('code_challenge_method')).toBe('S256')
+        if (id === 'google') {
+          expect(url.searchParams.get('scope')).toBe('openid email profile')
+          expect(url.searchParams.get('nonce')).toBe(input.nonce)
+        } else {
+          expect(url.searchParams.get('scope')).toBe('read:user user:email')
+        }
+      }
+    },
+  )
+
+  test.each([
+    'http://pds.example.com/callback',
+    'https://user:password@pds.example.com/callback',
+    'https://pds.example.com/callback#fragment',
+  ])('rejects unsafe redirect URI %s', async (redirectUri) => {
+    const google = provider('google')
+    expect(() =>
+      google.authorizationUrl({
+        ...input,
+        redirectUri,
+        state: 'state',
+        codeChallenge: 'c'.repeat(43),
+      }),
+    ).toThrow()
+    await expect(google.exchange({ ...input, redirectUri })).rejects.toThrow()
+  })
+
+  it('rejects missing nonce and malformed PKCE before network access', async () => {
+    using fetch = vi.spyOn(globalThis, 'fetch')
+    await expect(
+      provider('google').exchange({ ...input, nonce: '' }),
+    ).rejects.toThrow()
+    await expect(
+      provider('google').exchange({ ...input, verifier: 'short' }),
+    ).rejects.toThrow()
+    expect(fetch).not.toHaveBeenCalled()
+  })
+})
+
+describe.each(['apple', 'google'] as const)('%s ID tokens', (id) => {
+  it('verifies the signed subject and binds code exchange to the redirect URI', async () => {
+    const token = await sign(claims(id))
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    const identity = await provider(id).exchange(input)
+    expect(identity).toMatchObject({
+      provider: id,
+      subject: `${id}-stable-subject`,
+      email: 'person@example.com',
+      emailVerified: true,
+    })
+    const request = fetch.mock.calls[0]?.[1]
+    assert(request?.body instanceof URLSearchParams)
+    expect(request.body.get('code')).toBe(input.code)
+    expect(request.body.get('client_id')).toBe(clientId)
+    expect(request.body.get('client_secret')).toBe('client-secret')
+    expect(request.body.get('redirect_uri')).toBe(input.redirectUri)
+    expect(request.body.get('grant_type')).toBe('authorization_code')
+    expect(request.body.get('code_verifier')).toBe(
+      id === 'google' ? input.verifier : null,
+    )
+    expect(request.redirect).toBe('error')
+    expect(request.signal).toBeInstanceOf(AbortSignal)
+  })
+
+  test.each([
+    { name: 'wrong nonce', change: { nonce: 'another-request' } },
+    { name: 'wrong audience', change: { aud: 'another-client' } },
+    { name: 'wrong issuer', change: { iss: 'https://attacker.example.com' } },
+    { name: 'expired token', change: { exp: 1 } },
+    { name: 'stale issued-at', change: { iat: 1 } },
+    { name: 'future issued-at', change: { iat: 4_000_000_000 } },
+    { name: 'missing nonce', change: { nonce: undefined } },
+    { name: 'missing issued-at', change: { iat: undefined } },
+    { name: 'missing expiration', change: { exp: undefined } },
+    { name: 'missing subject', change: { sub: undefined } },
+    { name: 'empty subject', change: { sub: '' } },
+    { name: 'wrong authorized party', change: { azp: 'another-client' } },
+    { name: 'ambiguous audience', change: { aud: [clientId, 'other-client'] } },
+  ])('rejects $name', async ({ change }) => {
+    const token = await sign({ ...claims(id), ...change })
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    await expect(provider(id).exchange(input)).rejects.toThrow()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+
+  it('rejects a token signed by an attacker using a known key ID', async () => {
+    const attacker = await generateKeyPair('RS256')
+    const token = await sign(claims(id), attacker.privateKey)
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    await expect(provider(id).exchange(input)).rejects.toThrow()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+
+  it('rejects an unsigned token', async () => {
+    const token = `${Buffer.from('{"alg":"none"}').toString('base64url')}.${Buffer.from(JSON.stringify(claims(id))).toString('base64url')}.`
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    await expect(provider(id).exchange(input)).rejects.toThrow()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+
+  it('rejects a signed token using an algorithm outside the provider allowlist', async () => {
+    const token = await new SignJWT(claims(id))
+      .setProtectedHeader({ alg: 'RS512', kid: 'test-key' })
+      .sign(keys.privateKey)
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    await expect(provider(id).exchange(input)).rejects.toThrow()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+
+  test.each([false, 'false', undefined, 1])(
+    'does not treat email_verified=%j as verified',
+    async (email_verified) => {
+      const token = await sign({ ...claims(id), email_verified })
+      using fetch = vi
+        .spyOn(globalThis, 'fetch')
+        .mockImplementation(oidcResponses(token))
+      expect((await provider(id).exchange(input)).emailVerified).toBe(false)
+      expect(fetch).toHaveBeenCalledTimes(2)
+    },
+  )
+
+  it('allows a known subject to be returned without an email assertion', async () => {
+    const token = await sign({ ...claims(id), email: undefined })
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    expect(await provider(id).exchange(input)).toMatchObject({
+      subject: `${id}-stable-subject`,
+      email: undefined,
+      emailVerified: false,
+    })
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('Apple first-login data', () => {
+  it('reads the initial name while ignoring the unsigned email field', async () => {
+    const token = await sign({ ...claims('apple'), email_verified: 'true' })
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    const identity = await provider('apple').exchange({
+      ...input,
+      user: JSON.stringify({
+        name: { firstName: 'A', lastName: 'Person' },
+        email: 'attacker@example.com',
+      }),
+    })
+    expect(identity).toMatchObject({
+      displayName: 'A Person',
+      email: 'person@example.com',
+      emailVerified: true,
+    })
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+
+  test.each([
+    '{invalid',
+    'x'.repeat(4097),
+    JSON.stringify({ name: { firstName: ['not-a-name'] } }),
+    JSON.stringify({ name: { firstName: 'name\u0000' } }),
+    JSON.stringify({ name: { firstName: 'x'.repeat(257) } }),
+  ])('rejects malformed first-login data %j', async (user) => {
+    const token = await sign(claims('apple'))
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockImplementation(oidcResponses(token))
+    await expect(
+      provider('apple').exchange({ ...input, user }),
+    ).rejects.toThrow()
+    expect(fetch).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('GitHub identity', () => {
+  it('uses immutable numeric ID and the verified primary email', async () => {
+    using fetch = vi.spyOn(globalThis, 'fetch').mockImplementation(
+      githubResponses([
+        { email: 'secondary@example.com', primary: false, verified: true },
+        { email: 'primary@example.com', primary: true, verified: true },
+      ]),
+    )
+    expect(await provider('github').exchange(input)).toEqual({
+      provider: 'github',
+      subject: '123456',
+      email: 'primary@example.com',
+      emailVerified: true,
+      displayName: 'A Person',
+    })
+    const tokenRequest = fetch.mock.calls[0]?.[1]
+    assert(tokenRequest?.body instanceof URLSearchParams)
+    expect(tokenRequest.body.get('code_verifier')).toBe(input.verifier)
