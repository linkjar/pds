+  })
+
+  it('does not expose provider errors or returned secrets', async () => {
+    using fetch = vi
+      .spyOn(globalThis, 'fetch')
+      .mockResolvedValue(
+        Response.json({ error: 'a-secret-error' }, { status: 400 }),
+      )
+    await expect(provider('github').exchange(input)).rejects.toThrow(
+      'External provider request failed',
+    )
+    expect(fetch).toHaveBeenCalledTimes(1)
+  })
+})
