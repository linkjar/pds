--- /dev/null
+++ b/packages/oauth/oauth-provider/src/external/external-provider.ts
@@ -0,0 +1,307 @@
+import { Buffer } from 'node:buffer'
+import { createLocalJWKSet, jwtVerify } from 'jose'
+
+export type ExternalProviderId = 'apple' | 'google' | 'github'
+
+export type ExternalIdentity = {
+  provider: ExternalProviderId
+  subject: string
+  email?: string
+  emailVerified: boolean
+  displayName?: string
+}
+
+export type ExternalProvider = {
+  id: ExternalProviderId
+  label: string
+  authorizationUrl(input: {
+    redirectUri: string
+    state: string
+    nonce: string
+    codeChallenge: string
+  }): URL
+  exchange(input: {
+    redirectUri: string
+    code: string
+    verifier: string
+    nonce: string
+    user?: string
+  }): Promise<ExternalIdentity>
+}
+
+export type ExternalProviderConfig = Partial<
+  Record<ExternalProviderId, { clientId: string; clientSecret: string }>
+>
+
+const providers = {
+  apple: {
+    label: 'Apple',
+    authorization: 'https://appleid.apple.com/auth/authorize',
+    token: 'https://appleid.apple.com/auth/token',
+    issuer: 'https://appleid.apple.com',
+    jwks: 'https://appleid.apple.com/auth/keys',
+    scope: 'name email',
+  },
+  google: {
+    label: 'Google',
+    authorization: 'https://accounts.google.com/o/oauth2/v2/auth',
+    token: 'https://oauth2.googleapis.com/token',
+    issuer: 'https://accounts.google.com',
+    jwks: 'https://www.googleapis.com/oauth2/v3/certs',
+    scope: 'openid email profile',
+  },
+  github: {
+    label: 'GitHub',
+    authorization: 'https://github.com/login/oauth/authorize',
+    token: 'https://github.com/login/oauth/access_token',
+    scope: 'read:user user:email',
+  },
+} as const
+
+/** Creates configured providers; identities are keyed by provider and subject, never email. */
+export function createExternalProviders(
+  config: ExternalProviderConfig,
+): ExternalProvider[] {
+  const result: ExternalProvider[] = []
+  for (const id of ['apple', 'google', 'github'] as const) {
+    const credentials = config[id]
+    if (credentials === undefined) continue
+    const clientId = requiredText(credentials.clientId, 512)
+    const clientSecret = requiredText(credentials.clientSecret, 16_384)
+    const spec = providers[id]
+    result.push({
+      id,
+      label: spec.label,
+      authorizationUrl({ redirectUri, state, nonce, codeChallenge }) {
+        validateRedirectUri(redirectUri)
+        const url = new URL(spec.authorization)
+        url.search = new URLSearchParams({
+          client_id: clientId,
+          redirect_uri: redirectUri,
+          response_type: 'code',
+          scope: spec.scope,
+          state: requiredText(state, 512),
+        }).toString()
+        if (id !== 'github') {
+          url.searchParams.set('nonce', requiredText(nonce, 512))
+        }
+        if (id === 'apple') {
+          url.searchParams.set('response_mode', 'form_post')
+        } else {
+          if (!/^[A-Za-z0-9_-]{43}$/.test(codeChallenge)) {
+            throw new Error('Invalid external provider PKCE challenge')
+          }
+          url.searchParams.set('code_challenge', codeChallenge)
+          url.searchParams.set('code_challenge_method', 'S256')
+        }
+        return url
+      },
+      async exchange({ redirectUri, code, verifier, nonce, user }) {
+        validateRedirectUri(redirectUri)
+        if (id !== 'github') requiredText(nonce, 512)
+        const body = new URLSearchParams({
+          grant_type: 'authorization_code',
+          client_id: clientId,
+          client_secret: clientSecret,
+          redirect_uri: redirectUri,
+          code: requiredText(code, 4096),
+        })
+        if (id !== 'apple') {
+          if (!/^[A-Za-z0-9._~-]{43,128}$/.test(verifier)) {
+            throw new Error('Invalid external provider PKCE verifier')
+          }
+          body.set('code_verifier', verifier)
+        }
+        const token = record(
+          await fetchJson(spec.token, { method: 'POST', body }),
+        )
+        if (token.error !== undefined) {
+          throw new Error('External provider rejected authorization code')
+        }
+        if (id === 'github') {
+          if (
+            typeof token.token_type !== 'string' ||
+            token.token_type.toLowerCase() !== 'bearer'
+          ) {
+            throw new Error('Invalid external provider token type')
+          }
+          return githubIdentity(requiredText(token.access_token, 4096))
+        }
+        const oidc = providers[id]
+        const keys = record(await fetchJson(oidc.jwks)).keys
+        if (!Array.isArray(keys) || keys.length === 0 || keys.length > 32) {
+          throw new Error('Invalid external provider signing keys')
+        }
+        const jwks = createLocalJWKSet({
+          keys: keys.map((value: unknown) => {
+            const key = record(value)
+            return { ...key, kty: requiredText(key.kty, 16) }
+          }),
+        })
+        const { payload } = await jwtVerify(
+          requiredText(token.id_token, 32_768),
+          jwks,
+          {
+            issuer: oidc.issuer,
+            audience: clientId,
+            algorithms: ['RS256'],
+            requiredClaims: ['iss', 'aud', 'sub', 'iat', 'exp', 'nonce'],
+            maxTokenAge: 600,
+          },
+        )
+        if (
+          payload.nonce !== nonce ||
+          (payload.azp !== undefined && payload.azp !== clientId) ||
+          (Array.isArray(payload.aud) &&
+            payload.aud.length > 1 &&
+            payload.azp !== clientId)
+        ) {
+          throw new Error('Invalid external provider token binding')
+        }
+        const email = optionalEmail(payload.email)
+        return {
+          provider: id,
+          subject: requiredText(payload.sub, 255),
+          email,
+          emailVerified:
+            email !== undefined &&
+            (payload.email_verified === true ||
+              (id === 'apple' && payload.email_verified === 'true')),
+          displayName:
+            id === 'apple'
+              ? appleDisplayName(user)
+              : optionalDisplayName(payload.name),
+        }
+      },
+    })
+  }
+  return result
+}
+
+async function githubIdentity(accessToken: string): Promise<ExternalIdentity> {
+  const headers = {
+    Authorization: `Bearer ${accessToken}`,
+    'X-GitHub-Api-Version': '2022-11-28',
+    'User-Agent': 'atproto-external-auth',
+  }
+  const user = record(
+    await fetchJson('https://api.github.com/user', { headers }),
+  )
+  if (
+    typeof user.id !== 'number' ||
+    !Number.isSafeInteger(user.id) ||
+    user.id <= 0
+  ) {
+    throw new Error('Invalid GitHub subject')
+  }
+  const emails = await fetchJson(
+    'https://api.github.com/user/emails?per_page=100',
+    { headers },
+  )
+  if (!Array.isArray(emails) || emails.length > 100) {
+    throw new Error('Invalid GitHub email list')
+  }
+  const primary = emails.map(record).filter((entry) => entry.primary === true)
+  if (primary.length > 1) throw new Error('Ambiguous GitHub primary email')
+  // @NOTE /user.email and verified secondary addresses are not primary-email evidence.
+  const email =
+    primary[0]?.verified === true ? optionalEmail(primary[0].email) : undefined
+  return {
+    provider: 'github',
+    subject: String(user.id),
+    email,
+    emailVerified: email !== undefined,
+    displayName: optionalDisplayName(user.name ?? user.login),
+  }
+}
+
+async function fetchJson(
+  url: string,
+  init: RequestInit = {},
+): Promise<unknown> {
+  const response = await fetch(url, {
+    ...init,
+    headers: { Accept: 'application/json', ...init.headers },
+    redirect: 'error',
+    signal: AbortSignal.timeout(10_000),
+  })
+  if (!response.ok || !response.body) {
+    await response.body?.cancel()
+    throw new Error('External provider request failed')
+  }
+  const reader = response.body.getReader()
+  const chunks: Uint8Array[] = []
+  let size = 0
+  try {
+    for (;;) {
+      const { done, value } = await reader.read()
+      if (done) break
+      size += value.byteLength
+      if (size > 128 * 1024) {
+        throw new Error('External provider response is too large')
+      }
+      chunks.push(value)
+    }
+    return JSON.parse(Buffer.concat(chunks).toString('utf8')) as unknown
+  } finally {
+    await reader.cancel()
+    reader.releaseLock()
+  }
+}
+
+function record(value: unknown): Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error('Invalid external provider response')
+  }
+  return value as Record<string, unknown>
+}
+
+function requiredText(value: unknown, maxLength: number): string {
+  if (
+    typeof value !== 'string' ||
+    value.length === 0 ||
+    value.length > maxLength ||
+    value.trim() !== value ||
+    /\p{Cc}/u.test(value)
+  ) {
+    throw new Error('Invalid external provider value')
+  }
+  return value
+}
+
+function optionalEmail(value: unknown): string | undefined {
+  if (value === undefined || value === null) return undefined
+  const email = requiredText(value, 254)
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+    throw new Error('Invalid external provider email')
+  }
+  return email
+}
+
+function optionalDisplayName(value: unknown): string | undefined {
+  if (value === undefined || value === null || value === '') return undefined
+  return requiredText(value, 256)
+}
+
+function appleDisplayName(user: string | undefined): string | undefined {
+  if (user === undefined) return undefined
+  if (Buffer.byteLength(user, 'utf8') > 4096) {
+    throw new Error('Invalid Apple user data')
+  }
+  const data = record(JSON.parse(user) as unknown)
+  if (data.name === undefined) return undefined
+  const name = record(data.name)
+  // @NOTE Apple's form field is display data, never proof of email or identity.
+  return optionalDisplayName(
+    [optionalDisplayName(name.firstName), optionalDisplayName(name.lastName)]
+      .filter(Boolean)
+      .join(' '),
+  )
+}
+
+function validateRedirectUri(value: string): void {
+  const url = new URL(value)
+  if (url.protocol !== 'https:' || url.username || url.password || url.hash) {
+    throw new Error('Invalid external provider redirect URI')
+  }
+}
