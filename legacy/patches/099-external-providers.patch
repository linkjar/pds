+import type { Did } from '@atproto/did'
+import type { Account } from '@atproto/oauth-provider-api'
+import type {
+  ExternalIdentity,
+  ExternalProviderId,
+} from './external-provider.js'
+
+/** An external identity is keyed by provider and subject, never by email. */
+export interface ExternalIdentityStore {
+  findExternalIdentity(
+    provider: ExternalProviderId,
+    subject: string,
+  ): Promise<Did | null>
+  listExternalIdentities(did: Did): Promise<ExternalIdentity[]>
+  linkExternalIdentity(did: Did, identity: ExternalIdentity): Promise<void>
+  unlinkExternalIdentity(
+    did: Did,
+    provider: ExternalProviderId,
+    subject: string,
+  ): Promise<void>
+  createExternalAccount(identity: ExternalIdentity): Promise<Account>
+}
