+import { createHash } from 'node:crypto'
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import { z } from 'zod'
+import { InvalidRequestError } from '../errors/invalid-request-error.js'
+import { ExternalFlowStore } from '../external/external-flow-store.js'
+import {
+  type Middleware,
+  Router,
+  parseHttpRequest,
+  validateFetchSite,
+  validateReferrer,
+} from '../lib/http/index.js'
+import type { OAuthProvider } from '../oauth-provider.js'
+import { requestUriSchema } from '../request/request-uri.js'
+import { sendAuthorizePageFactory } from './assets/send-authorization-page.js'
+import { sendErrorPageFactory } from './assets/send-error-page.js'
+import { sendAuthorizationResultRedirect } from './assets/send-redirect.js'
+import type { MiddlewareOptions } from './middleware-options.js'
+
+const responseSchema = z
+  .object({ state: z.string().regex(/^[A-Za-z0-9_-]{43}$/) })
+  .and(
+    z.union([
+      z.object({
+        code: z.string().min(1).max(4096),
+        user: z.string().max(8192).optional(),
+        error: z.undefined(),
+      }),
+      z.object({ error: z.string().min(1).max(128), code: z.undefined() }),
+    ]),
+  )
+
+export function createExternalMiddleware<
+  Ctx extends object | void = void,
+  Req extends IncomingMessage = IncomingMessage,
+  Res extends ServerResponse = ServerResponse,
+>(
+  server: OAuthProvider,
+  { onError }: MiddlewareOptions<Req, Res>,
+): Middleware<Ctx, Req, Res> {
+  const origin = new URL(server.issuer)
+  const router = new Router<Ctx, Req, Res>(origin)
+  const flows = new ExternalFlowStore()
+  const sendError = sendErrorPageFactory(server.customization)
+  const sendAuthorize = sendAuthorizePageFactory(server.customization)
+
+  for (const provider of server.externalProviders) {
+    const base = `/oauth/external/${provider.id}`
+    const redirectUri = new URL(`${base}/callback`, origin).href
+    router.get(
+      `${base}/start`,
+      handle(async (req, res) => {
+        validateFetchSite(req, ['same-origin'])
+        const referrer = validateReferrer(req, {
+          origin: origin.origin,
+        })
+        const url = new URL(req.url!, origin)
+        const accountPage =
+          referrer.pathname === '/account' ||
+          referrer.pathname.startsWith('/account/')
+        if (!accountPage && referrer.pathname !== '/oauth/authorize')
+          throw new InvalidRequestError('Invalid external sign-in page')
+        const requestUri = accountPage
+          ? undefined
+          : requestUriSchema.parse(url.searchParams.get('request_uri'))
+        if (
+          accountPage
+            ? url.searchParams.has('request_uri')
+            : referrer.searchParams.get('request_uri') !== requestUri
+        )
+          throw new InvalidRequestError('Authorization request mismatch')
+        const { deviceId, deviceMetadata } = await server.deviceManager.load(
+          req,
+          res,
+        )
+        flows.allow(deviceMetadata.ipAddress, 'start')
+        if (requestUri) await server.requestManager.get(requestUri, deviceId)
+        const { state, flow } = flows.create({
+          provider: provider.id,
+          deviceId,
+          requestUri,
+        })
+        const target = provider.authorizationUrl({
+          redirectUri,
+          state,
+          nonce: flow.nonce,
+          codeChallenge: createHash('sha256')
+            .update(flow.verifier)
+            .digest('base64url'),
+        })
+        res.writeHead(303, { Location: target.href }).end()
+      }),
+    )
+
+    const callback = handle(async (req, res) => {
+      const input = responseSchema.parse(
+        req.method === 'POST'
+          ? await parseHttpRequest(req, ['urlencoded'], 16384)
+          : Object.fromEntries(new URL(req.url!, origin).searchParams),
+      )
+      flows.receive(
+        input.state,
+        provider.id,
+        input.error !== undefined
+          ? { error: input.error }
+          : {
+              code: input.code!,
+              user: 'user' in input ? input.user : undefined,
+            },
+      )
+      // @NOTE Apple posts cross-site. The same-origin GET restores the existing
+      // SameSite=Lax device cookie before any token exchange or account mutation.
+      res
+        .writeHead(303, {
+          Location: `${base}/complete?state=${encodeURIComponent(input.state)}`,
+        })
+        .end()
+    })
