diff --git a/packages/oauth/oauth-provider-ui/src/components/external-sign-in.tsx b/packages/oauth/oauth-provider-ui/src/components/external-sign-in.tsx
new file mode 100644
index 0000000..d5bac18
--- /dev/null
+++ b/packages/oauth/oauth-provider-ui/src/components/external-sign-in.tsx
@@ -0,0 +1,45 @@
+import { Trans } from '@lingui/react/macro'
+import type { ReactNode } from 'react'
+import { useCustomizationData } from '#/contexts/customization.tsx'
+import { SignUpDisclaimer } from './sign-up-disclaimer.tsx'
+
+export function ExternalSignIn({
+  children,
+  signUp = false,
+}: {
+  children: ReactNode
+  signUp?: boolean
+}) {
+  const { externalProviders, links } = useCustomizationData()
+  const url = new URL(window.location.href)
+  const requestUri =
+    url.pathname === '/oauth/authorize'
+      ? url.searchParams.get('request_uri')
+      : null
+  const accountPage =
+    url.pathname === '/account' || url.pathname.startsWith('/account/')
+  if ((!requestUri && !accountPage) || !externalProviders?.length)
+    return <>{children}</>
+  return (
+    <div className="grid gap-4">
+      <div className="grid gap-2">
+        {externalProviders.map(({ id, label }) => (
+          <a
+            key={id}
+            className="hover:bg-muted rounded-lg border px-4 py-3 text-center font-medium focus-visible:outline-2"
+            href={`/oauth/external/${id}/start${requestUri ? `?request_uri=${encodeURIComponent(requestUri)}` : ''}`}
+          >
+            <Trans>Continue with {label}</Trans>
+          </a>
+        ))}
+      </div>
+      {signUp && <SignUpDisclaimer links={links} />}
+      <details>
+        <summary className="cursor-pointer py-2 text-center">
+          <Trans>Or use email</Trans>
+        </summary>
+        <div className="pt-4">{children}</div>
+      </details>
+    </div>
+  )
+}
