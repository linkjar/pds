# Merge these raw KEY=VALUE entries into the private PDS environment from #90.
# Do not source this file. Leave values unquoted with Compose format: raw.
# This example is incomplete until policy publication and credential setup.
PDS_SERVICE_NAME=LinkJar
PDS_LOGO_URL=https://linkjar.io/logo/linkjar-128.png
PDS_HOME_URL=https://linkjar.io
# Light app accent/success; inherited HeroUI danger/warning converted to sRGB.
# The provider uses one palette in both themes and derives contrasting text.
PDS_PRIMARY_COLOR=#1d5fec
PDS_ERROR_COLOR=#ff383c
PDS_WARNING_COLOR=#f5a524
PDS_INFO_COLOR=#1d5fec
PDS_SUCCESS_COLOR=#059669
PDS_OAUTH_TRUSTED_CLIENTS=https://app.linkjar.io/client-metadata.json,https://linkjar.io/ios-client-metadata.json,https://linkjar.io/ext-client-metadata.json
PDS_HOSTNAME=pds.linkjar.social
PDS_SERVICE_HANDLE_DOMAINS=.linkjar.social
PDS_INVITE_REQUIRED=false
PDS_RATE_LIMITS_ENABLED=true
PDS_DEV_MODE=false
# Supply all three through the private provisioning wizard. Never commit them.
PDS_HCAPTCHA_SITE_KEY=
PDS_HCAPTCHA_SECRET_KEY=
PDS_HCAPTCHA_TOKEN_SALT=
# Fill only after the reviewed hosting documents are published on linkjar.io.
PDS_TERMS_OF_SERVICE_URL=
PDS_PRIVACY_POLICY_URL=
PDS_SUPPORT_URL=
PDS_CONTACT_EMAIL_ADDRESS=
