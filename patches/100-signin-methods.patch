diff --git a/packages/oauth/oauth-provider-ui/src/data/sign-in-methods.ts b/packages/oauth/oauth-provider-ui/src/data/sign-in-methods.ts
new file mode 100644
index 0000000..d1e9431
--- /dev/null
+++ b/packages/oauth/oauth-provider-ui/src/data/sign-in-methods.ts
@@ -0,0 +1,35 @@
+import { msg } from '@lingui/core/macro'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import type {
+  DidString,
+  UnlinkSignInMethodInput,
+} from '@atproto/oauth-provider-api'
+import { useNotificationsContext } from '#/contexts/notifications.tsx'
+import { useApi } from '#/contexts/session.tsx'
+
+export function useSignInMethods(did: DidString) {
+  const api = useApi()
+  return useQuery({
+    queryKey: ['sign-in-methods', did],
+    staleTime: 0,
+    refetchOnWindowFocus: 'always',
+    queryFn: ({ signal }) => api.signInMethods(did, { signal }),
+  })
+}
+
+export function useUnlinkSignInMethod() {
+  const api = useApi()
+  const queryClient = useQueryClient()
+  const { notify, notifyError } = useNotificationsContext()
+  return useMutation({
+    mutationFn: (input: UnlinkSignInMethodInput) =>
+      api.unlinkSignInMethod(input),
+    onSuccess(_data, { did }) {
+      queryClient.invalidateQueries({ queryKey: ['sign-in-methods', did] })
+      notify({ title: msg`Sign-in method removed` })
+    },
+    onError(error) {
+      notifyError(error, { title: msg`Could not remove sign-in method` })
+    },
+  })
+}
