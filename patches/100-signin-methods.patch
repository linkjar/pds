 } from '@atproto/oauth-provider-api'
@@ -102,6 +103,14 @@ export class Api extends JsonClient<ApiEndpoints> {
 
   // Account sessions
 
+  async signInMethods(did: DidString, options?: Options) {
+    return this.fetch('GET', '/sign-in-methods', { did }, options)
+  }
+
+  async unlinkSignInMethod(input: UnlinkSignInMethodInput, options?: Options) {
+    return this.fetch('POST', '/unlink-sign-in-method', input, options)
+  }
+
   async accountSessions({ did }: AccountSessionsInput, options?: Options) {
     return this.fetch('GET', '/account-sessions', { did }, options)
   }
