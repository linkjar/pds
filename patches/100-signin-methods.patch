diff --git a/packages/pds/src/account-manager/helpers/sign-in-notices.ts b/packages/pds/src/account-manager/helpers/sign-in-notices.ts
new file mode 100644
index 0000000..6c59d42
--- /dev/null
+++ b/packages/pds/src/account-manager/helpers/sign-in-notices.ts
@@ -0,0 +1,93 @@
+import { randomUUID } from 'node:crypto'
+import type { BackgroundQueue } from '../../background.js'
+import type { ServerMailer } from '../../mailer/index.js'
+import type { AccountDb } from '../db/index.js'
+import type { SignInNotice } from '../db/schema/sign-in-notice.js'
+
+/** Called inside the same transaction as the security-sensitive mutation. */
+export async function enqueueSignInNotice(
+  db: AccountDb,
+  did: string,
+  action: SignInNotice['action'],
+  provider?: string,
+) {
+  const account = await db.db
+    .selectFrom('account')
+    .select('email')
+    .where('did', '=', did)
+    .executeTakeFirstOrThrow()
+  const now = Date.now()
+  await db.db
+    .insertInto('sign_in_notice')
+    .values({
+      id: randomUUID(),
+      did,
+      recipient: account.email,
+      action,
+      provider: provider ?? null,
+      createdAt: now,
+      nextAttemptAt: now,
+      attempts: 0,
+    })
+    .execute()
+}
+
+export async function deliverSignInNotices(
+  db: AccountDb,
+  mailer: Pick<ServerMailer, 'sendSignInMethodChange'>,
+  now = Date.now(),
+) {
+  const rows = await db.db
+    .selectFrom('sign_in_notice')
+    .selectAll()
+    .where('nextAttemptAt', '<=', now)
+    .orderBy('createdAt')
+    .limit(100)
+    .execute()
+  for (const row of rows) {
+    try {
+      await mailer.sendSignInMethodChange(row)
+      await db.db
+        .deleteFrom('sign_in_notice')
+        .where('id', '=', row.id)
+        .execute()
+    } catch {
+      // Retain failures across restarts; no identity data or SMTP errors in logs.
+      await db.db
+        .updateTable('sign_in_notice')
+        .set({
+          attempts: row.attempts + 1,
+          nextAttemptAt:
+            now + Math.min(3_600_000, 60_000 * 2 ** Math.min(row.attempts, 6)),
+        })
+        .where('id', '=', row.id)
+        .execute()
+    }
+  }
+}
+
+/** One bounded dispatcher per PDS process, drained by its existing background queue. */
+export function startSignInNotices(
+  db: AccountDb,
+  mailer: ServerMailer,
+  queue: BackgroundQueue,
+) {
+  let running = false
+  const tick = () => {
+    if (running || queue.destroyed) return
+    running = true
+    queue.add(async () => {
+      try {
+        await deliverSignInNotices(db, mailer)
+      } finally {
+        running = false
+      }
+    })
+  }
+  const timer = setInterval(tick, 60_000)
+  timer.unref()
+  queue.signal.addEventListener('abort', () => clearInterval(timer), {
+    once: true,
+  })
+  tick()
+}
