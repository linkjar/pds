+  'r2',
+  'backup',
+  'backups',
+  'billing',
+  'pay',
+  'payments',
+  'secure',
+  'security',
+  'verify',
+  'verification',
+  'register',
+  'signup',
+  'signin',
+  'accounts',
+  'settings',
+  'profile',
+  'profiles',
+  'download',
+  'downloads',
+  'm',
+  'mobile',
+  'web',
+  'www1',
+])
+
+export const isLinkjarReservedLabel = (label: string): boolean => {
+  // ASCII handles only. Cover common digit substitutions and separated or
+  // numbered service lookalikes (pds2, api-prod, link-jar), not arbitrary names
+  // containing a service word such as "olivia" or "jared".
+  const skeleton = label
+    .toLowerCase()
+    .replace(
+      /[013457]/g,
+      (c) =>
+        ({ '0': 'o', '1': 'i', '3': 'e', '4': 'a', '5': 's', '7': 't' })[c]!,
+    )
+  const lSkeleton = label
+    .toLowerCase()
+    .replace(
+      /[013457]/g,
+      (c) =>
+        ({ '0': 'o', '1': 'l', '3': 'e', '4': 'a', '5': 's', '7': 't' })[c]!,
+    )
+  return [label.toLowerCase(), skeleton, lSkeleton].some(
+    (value) =>
+      linkjarReservedLabels.has(value) ||
+      linkjarReservedLabels.has(value.replace(/-/g, '')) ||
+      value.split('-').some((part) => linkjarReservedLabels.has(part)) ||
+      linkjarReservedLabels.has(value.replace(/\d+$/, '')) ||
+      value.startsWith('xn--'),
+  )
+}
