@@ -0,0 +1,65 @@
+import { InvalidRequestError } from '@atproto/xrpc-server'
+import { isLinkjarHandle } from '../../handle/linkjar.js'
+import type { AccountDb } from '../db/index.js'
+
+const RENAME_WINDOW_MS = 30 * 24 * 60 * 60 * 1000
+
+/** Called only inside the transaction creating a new provider-signup actor. */
+export const registerInitialHandlePolicy = async (
+  db: AccountDb,
+  did: string,
+  createdAt: string,
+) => {
+  db.assertTransaction()
+  await db.db
+    .insertInto('linkjar_handle_policy')
+    .values({ did, createdAt, renameHandle: null })
+    .execute()
+}
+
+/** Claim before any PLC write: concurrent requests cannot spend the allowance
+ * twice. Retain the target after errors because PLC may have accepted the write.
+ * Retrying the same target is safe even after the thirty-day boundary.
+ * Custom domains remain unrestricted and use upstream ownership verification.
+ */
+export const claimInitialHandleRename = async (
+  db: AccountDb,
+  did: string,
+  previousHandle: string | null,
+  handle: string,
+  now = Date.now(),
+): Promise<void> => {
+  if (!isLinkjarHandle(handle) || handle === previousHandle) return
+  await db.transaction(async (tx) => {
+    const policy = await tx.db
+      .selectFrom('linkjar_handle_policy')
+      .selectAll()
+      .where('did', '=', did)
+      .executeTakeFirst()
+    if (!policy || policy.renameHandle === handle) return
+    const createdAt = Date.parse(policy.createdAt)
+    if (
+      policy.renameHandle !== null ||
+      !Number.isFinite(createdAt) ||
+      now < createdAt ||
+      now >= createdAt + RENAME_WINDOW_MS
+    ) {
+      throw new InvalidRequestError(
+        'One hosted handle change is available within 30 days of signup. You can still use a domain you own.',
+        'HandleNotAvailable',
+      )
+    }
+    const result = await tx.db
+      .updateTable('linkjar_handle_policy')
+      .set({ renameHandle: handle })
+      .where('did', '=', did)
+      .where('renameHandle', 'is', null)
+      .executeTakeFirstOrThrow()
+    if (result.numUpdatedRows !== 1n) {
+      throw new InvalidRequestError(
+        'Handle change is already in progress.',
+        'HandleNotAvailable',
+      )
+    }
+  })
+}
