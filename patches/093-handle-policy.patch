+import { randomBytes } from 'node:crypto'
+import type { HandleString } from '@atproto/syntax'
+import { InvalidRequestError } from '@atproto/xrpc-server'
+import { hasExplicitSlur } from './explicit-slurs.js'
+import {
+  baseNormalizeAndValidate,
+  ensureHandleServiceConstraints,
+} from './index.js'
+
+export const LINKJAR_HANDLE_DOMAIN = '.linkjar.social'
+
+export const isLinkjarHandle = (handle: string): boolean =>
+  /^[a-z0-9][a-z0-9-]{1,16}[a-z0-9]\.linkjar\.social$/.test(handle)
+
+const normalizedLabel = (name: string): string =>
+  name
+    .slice(0, 512)
+    .normalize('NFKD')
+    .replace(/\p{M}/gu, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .slice(0, 18)
+    .replace(/^-+|-+$/g, '')
+
+const allowed = (label: string): boolean => {
+  const handle = `${label}${LINKJAR_HANDLE_DOMAIN}`
+  try {
+    baseNormalizeAndValidate(handle)
+    ensureHandleServiceConstraints(handle, [LINKJAR_HANDLE_DOMAIN])
+    return !hasExplicitSlur(handle)
+  } catch (err) {
+    if (err instanceof InvalidRequestError) return false
+    throw err
+  }
+}
+
+/** Availability is advisory; account creation still owns its unique constraint.
+ * The caller retries derivation after a concurrent signup wins that constraint.
+ * Provider claims are naming suggestions, never account identity or authority.
+ */
+export const deriveLinkjarHandle = async ({
+  displayName,
+  email,
+  isTaken,
+}: {
+  displayName?: string
+  email?: string
+  isTaken: (handle: HandleString) => Promise<boolean>
+}): Promise<HandleString> => {
+  const candidates = [displayName, email?.split('@')[0], 'reader']
+    .filter((value): value is string => !!value)
+    .map(normalizedLabel)
+  const base = candidates.find(allowed) ?? 'reader'
+  for (let attempt = 0; attempt < 32; attempt++) {
+    const label =
+      attempt === 0
+        ? base
+        : `${base.slice(0, 11).replace(/-+$/g, '')}-${randomBytes(3).toString('hex')}`
+    if (!allowed(label)) continue
+    const handle = baseNormalizeAndValidate(`${label}${LINKJAR_HANDLE_DOMAIN}`)
+    if (!(await isTaken(handle))) return handle
+  }
+  throw new InvalidRequestError(
+    'Could not allocate a handle. Please try again.',
+    'HandleNotAvailable',
+  )
+}
