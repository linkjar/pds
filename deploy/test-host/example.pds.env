# Copy to pds.env beside compose.yml and fill in the three secrets. The
# variables are the reference server's (docs/SPEC.md Appendix C).
# PDS_HOSTNAME comes from .env.

# Secrets. Generate each once and keep it: sessions and the PLC identities
# of the accounts depend on them.
#   openssl rand --hex 16
PDS_JWT_SECRET=
#   openssl rand --hex 16
PDS_ADMIN_PASSWORD=
#   openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

# Storage in the container. The compose file mounts the data directory here.
PDS_DATA_DIRECTORY=/app/data
PDS_BLOBSTORE_DISK_LOCATION=/app/data/blocks
PDS_BLOB_UPLOAD_LIMIT=104857600

# The public network. A new account writes its DID to this PLC directory,
# where it stays after the account is deleted.
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network

# Sign-up needs an invite code, which the admin password creates.
PDS_INVITE_REQUIRED=true

# Mail: confirmation and password reset. Without it the server sends none.
#PDS_EMAIL_SMTP_URL=smtps://user:password@smtp.example.com/
#PDS_EMAIL_FROM_ADDRESS=pds@example.com

# `stock` is the reference server's behaviour. `linkjar` adds LinkJar's
# sign-in providers, handle policy, receipt and sign-in methods; it needs
# the PDS_EXTERNAL_<PROVIDER>_CLIENT_ID and _CLIENT_SECRET of each provider.
PDS_PROFILE=stock

# The private metrics listener, inside the compose network only.
#PDS_METRICS_ADDRESS=0.0.0.0:9464
