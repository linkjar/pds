# Copy to .env beside compose.yml. Compose reads it; the server does not.

# The image, by digest: the summary of the "Server images" workflow run on
# main lists it. Never a tag.
PDS_IMAGE=ghcr.io/linkjar/pds-server@sha256:DIGEST

# The server's name. DNS must point it and *.<name> at this host.
PDS_HOSTNAME=pds.example.com

# The address Let's Encrypt writes to about the certificates.
ACME_EMAIL=operator@example.com

# Where the data directory lives on the host. Owned by uid 1000.
PDS_DATA_PATH=./data
