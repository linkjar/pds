# The edge of a host (pds.linkjar.io, docs/runbooks/test-host.md). Caddy
# asks the server's /tls-check before it requests a certificate, so that
# only the server's name and the handles of its active accounts get one.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://pds:3000/tls-check
	}
}

{$PDS_HOSTNAME}, *.{$PDS_HOSTNAME} {
	tls {
		on_demand
	}
	reverse_proxy pds:3000
}
