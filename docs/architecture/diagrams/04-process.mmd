flowchart LR
  subgraph proc [linkjar-pds process, tokio]
    pub[public listener<br/>PDS_PORT<br/>/xrpc, /oauth, /account, /.well-known, /tls-check]
    met[metrics listener<br/>PDS_METRICS_ADDRESS]
    ops[ops listener<br/>PDS_OPS_ADDRESS<br/>internal.* and live WebSocket]
    subgraph bg [supervised background tasks]
      t1[crawler notify]
      t2[scheduled deletion]
      t3[blob GC]
      t4[mail outbox]
      t5[DID cache refresh]
      t6[audit checkpoint]
      t7[permission-set cache]
    end
    prov[(providers: clock, random, StorageIo)]
    admission[admission<br/>8 uploads, 2 imports, 8 exports<br/>32 subscriptions]
    repo[repository admission<br/>8 jobs per DID, 64 overall<br/>async wait, one writer per DID]
    pool[(blocking pool: SQLite<br/>64 ordinary jobs, 4 audit jobs)]
  end
  proxy([reverse proxy<br/>asks /tls-check before a certificate]) --> pub
  console[[console]] --> ops & met
  bg --- prov
  pub --> admission --> pool
  admission --> repo --> pool
