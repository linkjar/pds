flowchart LR
  runner([parity harness<br/>scenarios, SDK at the pin, Chromium])
  fixtures([fixture server<br/>AppView, report service, OAuth clients<br/>Apple, Google, GitHub, hCaptcha])
  edge([TLS edge<br/>Caddy, production snippet])
  pds[PDS under test<br/>Reference, Stock Reference or Candidate]
  plc([PLC directory])
  relay([Sync 1.1 relay, strict])
  mail([mail catcher])
  data[(data volume)]
  sql[[SQL tool<br/>reads and ages rows]]
  transcripts[(transcripts<br/>one per scenario and target)]
  compare{compare two targets<br/>responses, repository CIDs, firehose<br/>OAuth flows, verify at pin}
  restore{restore run<br/>Reference, then Candidate, on one data volume<br/>bodies by hash, verify}
  later{later units<br/>migration, stock equivalence<br/>LinkJar journeys, Bluesky app}
  smoke([smoke test<br/>any PDS by its URL, no stack])
  host[PDS on a test host]
  runner --> edge
  edge --> pds
  edge --> fixtures
  pds --> plc
  pds --> mail
  pds --> relay
  relay --> edge
  pds --> data
  sql --> data
  runner --> sql
  runner --> transcripts
  transcripts --> compare
  transcripts --> restore
  data --> restore
  compare --> later
  runner --> smoke
  smoke --> host
