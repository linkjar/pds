flowchart LR
  subgraph console [ops console, private network]
    cui[[live views: connections, topology, repos, jobs, audit]]
    cact[[actions: takedown, suspend, quarantine, GC, verify, repair, #sync]]
    cotel[[planned: OTLP receiver and capped store<br/>traces, metrics, logs]]
  end
  subgraph mcp [MCP server, mcp.domain]
    rs[[MCP over Streamable HTTP<br/>OAuth 2.1 resource server: PRM, CIMD, PKCE]]
    meta[client metadata<br/>public HTTPS 443, checked addresses<br/>no redirects, 64 KiB, 10 s]
    reg[public registration<br/>30 attempts per minute<br/>4096 clients, refuse without eviction]
    br[[bridge: confidential atproto OAuth client<br/>DPoP key per session, in-memory session store]]
    tools[[eight tools, one resource template<br/>public records and account only]]
  end
  op([operator with a role-bearing OAuth session]) --> cui & cact
  cact -- internal.* ops API with reason --> pds[linkjar-pds]
  pds -- OTLP over HTTP --> cotel
  cotel -- forward --> graf([Prometheus, Grafana])
  ai([AI client]) --> rs --> br -- PAR, consent on the PDS page, XRPC --> pds
  rs --> meta & reg
  pds --> audit[(audit log: both client ids)]
