---
interface Props {
	src?: string;
	label?: string;
	kind?: 'document' | 'link';
}

const {
	src = '/llms-full.txt',
	label = 'Copy all docs',
	kind = 'document',
} = Astro.props;
---

<docs-copy data-src={src} data-kind={kind} data-mdast="ignore">
	<button type="button">
		<svg
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			aria-hidden="true"
		>
			<rect width="14" height="14" x="8" y="8" rx="2" />
			<path d="M4 16H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1" />
		</svg>
		<span class="copy-label">
			<span class="copy-reserve" aria-hidden="true">{label}</span>
			<span data-copy-label>{label}</span>
		</span>
	</button>
	<span class="copy-status" role="status" aria-live="polite"></span>
</docs-copy>

<script>
	import { copyDocument } from '../lib/copy-document.mjs';
	class DocsCopy extends HTMLElement {
		private reset?: ReturnType<typeof setTimeout>;
		private controller?: AbortController;

		disconnectedCallback() {
			clearTimeout(this.reset);
			this.controller?.abort();
		}

		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';
			const button = this.querySelector('button');
			const status = this.querySelector('[role="status"]');
			const label = this.querySelector('[data-copy-label]');
			if (!button || !status || !label) return;
			const originalLabel = label.textContent;
			button.addEventListener('click', async () => {
				clearTimeout(this.reset);
				delete this.dataset.error;
				button.disabled = true;
				button.setAttribute('aria-busy', 'true');
				label.textContent = 'Copying…';
				status.textContent = 'Copying…';
				const controller = new AbortController();
				this.controller = controller;
				const deadline = setTimeout(() => controller.abort(), 10_000);
				try {
					const url = new URL(this.dataset.src ?? '', window.location.origin);
					if (url.origin !== window.location.origin || !this.dataset.src) {
						throw new Error('The documentation must be on this site.');
					}
					if (!navigator.clipboard)
						throw new Error('The clipboard is unavailable.');
					if (this.dataset.kind === 'link') {
						await navigator.clipboard.writeText(url.href);
						label.textContent = 'Copied';
						status.textContent = 'Page link copied.';
						return;
					}
					await copyDocument(this.dataset.src ?? '', {
						origin: window.location.origin,
						clipboard: navigator.clipboard,
						item: typeof ClipboardItem === 'undefined' ? undefined : ClipboardItem,
						fetcher: fetch,
						signal: controller.signal,
					});
					label.textContent = 'Copied';
					status.textContent = 'Markdown copied. Paste into your AI assistant.';
				} catch {
					this.dataset.error = 'true';
					label.textContent = originalLabel;
					status.textContent =
						this.dataset.kind === 'link'
							? 'Could not copy. Copy the address from your browser.'
							: 'Could not copy. Open the Markdown link and copy its text.';
				} finally {
					clearTimeout(deadline);
					controller.abort();
					button.disabled = false;
					button.removeAttribute('aria-busy');
					this.reset = setTimeout(() => {
						label.textContent = originalLabel;
						status.textContent = '';
						delete this.dataset.error;
					}, 6000);
				}
			});
		}
	}

	if (!customElements.get('docs-copy'))
		customElements.define('docs-copy', DocsCopy);
</script>

<style>
	docs-copy {
		position: relative;
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.65rem;
	}
	button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--radius, 0.5rem);
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-text);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
		transition: background-color 150ms ease, transform 150ms ease;
	}
	@media (hover: hover) {
		button:hover {
			background: var(--sl-color-gray-6);
		}
	}
	button:active {
		transform: scale(0.98);
	}
	button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 3px;
	}
	button:disabled {
		cursor: wait;
		opacity: 0.7;
	}
	.copy-label { display: grid; }
	.copy-label > span { grid-area: 1 / 1; }
	.copy-reserve { visibility: hidden; }
	docs-copy:not([data-error]) .copy-status {
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	.copy-status {
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		z-index: 5;
		width: max-content;
		max-width: min(19rem, 75vw);
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		box-shadow: 0 4px 16px #0002;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-2);
	}
	.copy-status:empty {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		button { transition: none; }
		button:active { transform: none; }
	}
	@media print {
		docs-copy {
			display: none;
		}
	}
</style>
