# Raw environment data, never source/eval. Keep separate from the PDS runtime env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PDS_BACKUP_R2_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com
PDS_BACKUP_PREFIX=staging/REPLACE-UNIQUE-HOST-EPOCH/databases
PDS_BACKUP_R2_BUCKET=
PDS_BACKUP_SSE_KEY_FILE=/etc/linkjar-pds-backup/sse.key
RESTIC_REPOSITORY=s3:https://REPLACE.r2.cloudflarestorage.com/REPLACE/staging/host-material
RESTIC_PASSWORD_FILE=/etc/linkjar-pds-backup/restic.password
RESTIC_CACHE_DIR=/var/cache/linkjar-pds-backup/restic
AWS_DEFAULT_REGION=auto
