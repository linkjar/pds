<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="x-apple-disable-message-reformatting"><meta name="color-scheme" content="only dark"><meta name="supported-color-schemes" content="only dark"><title>Your sign-in method changed</title></head>
<body bgcolor="#020202" style="margin:0;padding:0;background:#020202;color:#ffffff;font-family:Arial,Helvetica,sans-serif">
<div style="display:none;max-height:0;overflow:hidden;opacity:0">Your sign-in method changed — {{config.serviceName}}</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#020202" style="background:#020202"><tr><td align="center" style="padding:48px 24px">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:480px">
<tr><td align="center"><a href="{{config.homeUrl}}"><img src="https://linkjar.io/logo/linkjar-128.png" width="56" height="56" alt="LinkJar" style="display:block;border:0;border-radius:16px;color:#ffffff;font-size:14px"></a></td></tr>
<tr><td align="center" style="padding:40px 0 12px;color:#3b82f6;font-size:10px;line-height:1.6;font-weight:600;letter-spacing:3px">ACCOUNT SECURITY</td></tr>
<tr><td align="center"><h1 style="margin:0;color:#ffffff;font-size:32px;font-weight:500;line-height:1.2;letter-spacing:-1px">Your sign-in method changed</h1></td></tr>
<tr><td style="padding-top:32px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td bgcolor="#090909" style="background:#090909;border:1px solid #191919;border-radius:16px;padding:28px 24px;color:#a3a3a3">
<p style="margin:0 0 24px;font-size:14px;line-height:1.9;color:#a3a3a3;text-align:center">{{change}}</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#111111;border-radius:8px"><tr><td style="padding:16px;font-size:13px;line-height:1.8;color:#a3a3a3;text-align:left"><strong style="color:#ededed">Account</strong><br><span style="word-break:break-all">{{did}}</span><br><br><strong style="color:#ededed">Time (UTC)</strong><br>{{time}}</td></tr></table>
<p style="margin:24px 0 0;font-size:14px;line-height:1.9;color:#a3a3a3;text-align:center">If you made this change, no action is needed.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-top:24px;border-top:1px solid #202020"><tr><td style="padding-top:20px;font-size:13px;line-height:1.7;color:#8c8c8c">If you did not make this change, open your account settings from the app. Review your sign-in methods and sessions, and contact support if you need help.</td></tr></table>
</td></tr></table></td></tr>
<tr><td align="center" style="padding:28px 8px 0;color:#8c8c8c;font-size:12px;line-height:1.8"><a href="{{config.homeUrl}}" style="color:#a3a3a3;text-decoration:underline">Open LinkJar</a> &nbsp;·&nbsp; <a href="https://linkjar.io/support/" style="color:#a3a3a3;text-decoration:underline">Get help</a><br>Never share your password, confirmation codes or Private Jar Recovery Kit.</td></tr>
<tr><td align="center" style="padding-top:32px;color:#737373;font-size:11px;line-height:1.8;letter-spacing:0.5px">LinkJar. Your links. Your jar. Forever.</td></tr>
</table></td></tr></table></body></html>
